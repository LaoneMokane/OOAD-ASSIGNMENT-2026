<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="banking.DashboardViewController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f3f6fa;">

    <left>
        <VBox spacing="14" prefWidth="220"
              style="-fx-background-color: #12345a;">
            <padding><Insets top="24" right="14" bottom="20" left="14"/></padding>

            <Label text="MY BANK"
                   style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>
            <Label text="BANKING SYSTEM"
                   style="-fx-text-fill: #afc8e8; -fx-font-size: 16px;"/>
            <Separator/>

            <Button text="DASHBOARD" onAction="#showDashboard" maxWidth="Infinity"/>
            <Button text="MY ACCOUNTS" onAction="#showMyAccount" maxWidth="Infinity"/>
            <Button text="OPEN ACCOUNT" onAction="#showOpenAccount" maxWidth="Infinity"/>
            <Button text="TRANSACTIONS" onAction="#showTransactions" maxWidth="Infinity"/>
            <Button text="TRANSACTION HISTORY" onAction="#showTransactionHistory" maxWidth="Infinity"/>
            <Button text="SIGN OUT" onAction="#signout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane style="-fx-padding: 24;">

            <VBox fx:id="dashboardPane" spacing="18">
                <VBox spacing="5"
                      style="-fx-background-color: #12365a; -fx-background-radius: 10; -fx-padding: 20;">
                    <Label fx:id="welcomeLabel" text="Welcome back"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Manage your accounts and transactions here."
                           style="-fx-text-fill: #e0ebf5;"/>
                </VBox>

                <HBox spacing="16">
                    <VBox spacing="7" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18; -fx-border-color: #d6e2ef; -fx-border-radius: 10;">
                        <Label text="Total Accounts"/>
                        <Label fx:id="totalAccountsLabel" text="0"
                               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                    <VBox spacing="7" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18; -fx-border-color: #d6e2ef; -fx-border-radius: 10;">
                        <Label text="Total Balance"/>
                        <Label fx:id="totalBalanceLabel" text="P 0.00"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #087f8c;"/>
                    </VBox>
                </HBox>

                <Label text="Recent Transactions"
                       style="-fx-font-size: 19px; -fx-font-weight: bold;"/>
                <TableView fx:id="recentTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="recentDateColumn" text="Date" prefWidth="150"/>
                        <TableColumn fx:id="recentTypeColumn" text="Type" prefWidth="140"/>
                        <TableColumn fx:id="recentAccountColumn" text="Account" prefWidth="200"/>
                        <TableColumn fx:id="recentAmountColumn" text="Amount" prefWidth="160"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="accountPane" spacing="16" visible="false" managed="false">
                <Label text="My Accounts"
                       style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                <Label text="View your bank accounts"/>
                <TableView fx:id="accountTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="accountNumberColumn" text="Account Number" prefWidth="240"/>
                        <TableColumn fx:id="accountTypeColumn" text="Account Type" prefWidth="200"/>
                        <TableColumn fx:id="balanceColumn" text="Balance (BWP)" prefWidth="220"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="openAccountPane" spacing="12" visible="false" managed="false">
                <Label text="Open New Account"
                       style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="accountType" promptText="Account type" maxWidth="400"/>
                <TextField fx:id="openingBalance" promptText="Opening balance (BWP)" maxWidth="400"/>
                <TextField fx:id="branch" promptText="Branch" maxWidth="400"/>
                <TextField fx:id="employerName" promptText="Employer name (cheque account)" maxWidth="400"/>
                <TextField fx:id="employerAddress" promptText="Employer address (cheque account)" maxWidth="400"/>
                <Button text="Open Account" onAction="#openAccount"/>
                <Label fx:id="openAccountMessage" wrapText="true"/>
            </VBox>

            <VBox fx:id="transactionPane" spacing="12" visible="false" managed="false">
                <Label text="Deposit / Withdraw"
                       style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="transactionAccount" promptText="Select account" maxWidth="400"/>
                <ComboBox fx:id="transactionType" promptText="Transaction type" maxWidth="400"/>
                <TextField fx:id="transactionAmount" promptText="Amount (BWP)" maxWidth="400"/>
                <TextField fx:id="transactionDescription" promptText="Description (optional)" maxWidth="400"/>
                <Button text="Submit Transaction" onAction="#submitTransaction"/>
                <Label fx:id="transactionMessage" wrapText="true"/>
            </VBox>

            <VBox fx:id="historyPane" spacing="12" visible="false" managed="false">
                <Label text="Transaction History"
                       style="-fx-font-size: 25px; -fx-font-weight: bold;"/>
                <HBox spacing="10">
                    <ComboBox fx:id="historyAccount" promptText="Select account" prefWidth="300"/>
                    <Button text="Load History" onAction="#loadHistory"/>
                </HBox>
                <Label fx:id="historyMessage"/>
                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="historyDateColumn" text="Date" prefWidth="170"/>
                        <TableColumn fx:id="historyTypeColumn" text="Type" prefWidth="150"/>
                        <TableColumn fx:id="historyAmountColumn" text="Amount" prefWidth="160"/>
                        <TableColumn fx:id="historyDescriptionColumn" text="Description" prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>

        </StackPane>
    </center>
</BorderPane>