<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="banking.LoginController"
         prefWidth="700" prefHeight="560"
         tabClosingPolicy="UNAVAILABLE">
    <tabs>
        <Tab text="Login">
            <content>
                <VBox alignment="CENTER" spacing="14">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>
                    <Label text="WELCOME TO MY BANK"
                           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label text="SECURE BANKING MANAGEMENT SYSTEM"/>
                    <TextField fx:id="loginUsername"
                               promptText="Username" maxWidth="300"/>
                    <PasswordField fx:id="loginPassword"
                                   promptText="Password" maxWidth="300"/>
                    <Button text="LOGIN" onAction="#login" prefWidth="180"/>
                    <Label fx:id="loginMessage"/>
                </VBox>
            </content>
        </Tab>

        <Tab text="Register">
            <content>
                <ScrollPane fitToWidth="true">
                    <content>
                        <VBox alignment="CENTER" spacing="9">
                            <padding>
                                <Insets top="20" right="40" bottom="20" left="40"/>
                            </padding>
                            <Label text="CREATE CUSTOMER ACCOUNT"
                                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="customerType"
                                      promptText="Customer type" maxWidth="300"/>
                            <TextField fx:id="firstName"
                                       promptText="First name (individual)" maxWidth="300"/>
                            <TextField fx:id="lastName"
                                       promptText="Surname (individual)" maxWidth="300"/>
                            <TextField fx:id="idNumber"
                                       promptText="ID number (individual)" maxWidth="300"/>
                            <TextField fx:id="companyName"
                                       promptText="Company name (company)" maxWidth="300"/>
                            <TextField fx:id="registrationNumber"
                                       promptText="Registration number (company)" maxWidth="300"/>
                            <TextField fx:id="contactPerson"
                                       promptText="Contact person (company)" maxWidth="300"/>
                            <TextField fx:id="address" promptText="Address" maxWidth="300"/>
                            <TextField fx:id="phone" promptText="Phone number" maxWidth="300"/>
                            <TextField fx:id="registerUsername"
                                       promptText="Choose username" maxWidth="300"/>
                            <PasswordField fx:id="registerPassword"
                                           promptText="Choose password" maxWidth="300"/>
                            <Button text="REGISTER" onAction="#register" prefWidth="180"/>
                            <Label fx:id="registerMessage"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </content>
        </Tab>
    </tabs>
</TabPane>