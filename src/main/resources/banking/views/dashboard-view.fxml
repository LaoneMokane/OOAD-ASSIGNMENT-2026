<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="banking.DashboardViewController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #f1f4f8;">

    <left>
        <VBox prefWidth="220" spacing="16"
              style="-fx-background-color: #12345A;">
            <padding>
                <Insets top="25" right="18" bottom="20" left="18"/>
            </padding>

            <Label text="MY BANK"
                   style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>
            <Label text="BANKING SYSTEM"
                   style="-fx-text-fill: #AFC8E8; -fx-font-size: 16px;"/>
            <Separator/>

            <Button text="DASHBOARD"
                    onAction="#showDashboard"
                    maxWidth="Infinity"/>
            <Button text="MY ACCOUNTS"
                    onAction="#showMyAccount"
                    maxWidth="Infinity"/>
            <Button text="OPEN ACCOUNT"
                    onAction="#showOpenAccount"
                    maxWidth="Infinity"/>
            <Button text="TRANSACTIONS"
                    onAction="#showTransactions"
                    maxWidth="Infinity"/>
            <Button text="TRANSACTION HISTORY"
                    onAction="#showTransactionHistory"
                    maxWidth="Infinity"/>
            <Button text="SIGN OUT"
                    onAction="#signout"
                    maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane style="-fx-background-color: #f1f4f8;">
            <padding>
                <Insets top="26" right="30" bottom="24" left="30"/>
            </padding>

            <!-- Dashboard overview -->
            <VBox fx:id="dashboardPane" spacing="18">
                <VBox spacing="5"
                      style="-fx-background-color: #12365a; -fx-background-radius: 10; -fx-padding: 20;">
                    <Label fx:id="welcomeLabel"
                           text="Welcome back"
                           style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Manage your accounts and transactions here."
                           style="-fx-font-size: 14px; -fx-text-fill: #e0ebf5;"/>
                </VBox>

                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d7e2ee; -fx-border-radius: 10; -fx-padding: 18;">
                        <Label text="TOTAL ACCOUNTS"
                               style="-fx-text-fill: #64748b;"/>
                        <Label fx:id="totalAccountsLabel"
                               text="0"
                               style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #12365a;"/>
                    </VBox>

                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d7e2ee; -fx-border-radius: 10; -fx-padding: 18;">
                        <Label text="TOTAL BALANCE"
                               style="-fx-text-fill: #64748b;"/>
                        <Label fx:id="totalBalanceLabel"
                               text="P 0.00"
                               style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #087f8c;"/>
                    </VBox>
                </HBox>

                <Label text="RECENT TRANSACTIONS"
                       style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #12365a;"/>

                <TableView fx:id="recentTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="recentDateColumn"
                                     text="Date" prefWidth="190"/>
                        <TableColumn fx:id="recentTypeColumn"
                                     text="Type" prefWidth="150"/>
                        <TableColumn fx:id="recentAccountColumn"
                                     text="Account" prefWidth="220"/>
                        <TableColumn fx:id="recentAmountColumn"
                                     text="Amount (BWP)" prefWidth="170"/>
                    </columns>
                </TableView>

                <Label fx:id="message"/>
            </VBox>

            <!-- My Accounts -->
            <VBox fx:id="accountPane"
                  spacing="14"
                  visible="false"
                  managed="false">
                <Label text="MY ACCOUNTS"
                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #12365a;"/>
                <Label text="View your bank accounts and balances."
                       style="-fx-text-fill: #64748b;"/>

                <TableView fx:id="accountTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="accountNumberColumn"
                                     text="Account Number" prefWidth="230"/>
                        <TableColumn fx:id="accountTypeColumn"
                                     text="Account Type" prefWidth="190"/>
                        <TableColumn fx:id="accountBalanceColumn"
                                     text="Balance (BWP)" prefWidth="190"/>
                        <TableColumn fx:id="accountStatusColumn"
                                     text="Status" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Open Account -->
            <VBox fx:id="openAccountPane"
                  spacing="12"
                  visible="false"
                  managed="false">
                <Label text="OPEN NEW ACCOUNT"
                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #12365a;"/>
                <Label text="Choose an account type and provide its opening details."
                       style="-fx-text-fill: #64748b;"/>
                <ComboBox fx:id="accountType"
                          promptText="Account type" maxWidth="420"/>
                <TextField fx:id="openingBalance"
                           promptText="Opening balance (BWP)" maxWidth="420"/>
                <TextField fx:id="branch"
                           promptText="Branch" maxWidth="420"/>
                <TextField fx:id="employerName"
                           promptText="Employer name (cheque account)" maxWidth="420"/>
                <TextField fx:id="employerAddress"
                           promptText="Employer address (cheque account)" maxWidth="420"/>
                <Button text="OPEN ACCOUNT" onAction="#openAccount"/>
                <Label fx:id="openAccountMessage" wrapText="true"/>
            </VBox>

            <!-- Deposit and Withdraw -->
            <VBox fx:id="transactionsPane"
                  spacing="12"
                  visible="false"
                  managed="false">
                <Label text="DEPOSIT / WITHDRAW"
                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #12365a;"/>
                <Label text="Manage money in one of your accounts."
                       style="-fx-text-fill: #64748b;"/>
                <ComboBox fx:id="transactionAccount"
                          promptText="Select account" maxWidth="420"/>
                <ComboBox fx:id="transactionType"
                          promptText="Transaction type" maxWidth="420"/>
                <TextField fx:id="transactionAmount"
                           promptText="Amount (BWP)" maxWidth="420"/>
                <Button text="SUBMIT TRANSACTION"
                        onAction="#submitTransaction"/>
                <Label fx:id="transactionMessage" wrapText="true"/>
            </VBox>

            <!-- Transaction History -->
            <VBox fx:id="historyPane"
                  spacing="12"
                  visible="false"
                  managed="false">
                <Label text="TRANSACTION HISTORY"
                       style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #12365a;"/>
                <Label text="Select an account to view its transactions."
                       style="-fx-text-fill: #64748b;"/>
                <ComboBox fx:id="historyAccount"
                          promptText="Select account" maxWidth="420"/>
                <Button text="LOAD HISTORY"
                        onAction="#loadHistory" maxWidth="180"/>
                <TextArea fx:id="historyText"
                          editable="false"
                          wrapText="true"
                          VBox.vgrow="ALWAYS"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>