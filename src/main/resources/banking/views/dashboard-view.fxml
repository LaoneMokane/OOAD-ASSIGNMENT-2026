<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="banking.DashboardViewController"
            prefWidth="1100" prefHeight="700">
    <left>
        <VBox prefWidth="220" spacing="16"
              style="-fx-background-color: #12345A;">
            <padding>
                <Insets top="25" right="18" bottom="20" left="18"/>
            </padding>
            <Label text="MY BANK"
                   style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>
            <Label text="BANKING SYSTEM"
                   style="-fx-text-fill: #AFC8E8; -fx-font-size: 16px;"/>
            <Separator/>
            <Button text="DASHBOARD" onAction="#showDashboard" maxWidth="Infinity"/>
            <Button text="MY ACCOUNTS" onAction="#showMyAccount" maxWidth="Infinity"/>
            <Button text="OPEN ACCOUNT" onAction="#showOpenAccount" maxWidth="Infinity"/>
            <Button text="TRANSACTIONS" onAction="#showTransactions" maxWidth="Infinity"/>
            <Button text="TRANSACTION HISTORY" onAction="#showTransactionHistory" maxWidth="Infinity"/>
            <Button text="SIGN OUT" onAction="#signout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane style="-fx-background-color: #eef1f5;">
            <padding>
                <Insets top="30" right="35" bottom="25" left="35"/>
            </padding>

            <VBox fx:id="dashboardPane" spacing="18">
                <Label fx:id="welcomeLabel" text="WELCOME BACK"
                       style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Label text="YOUR BANKING OVERVIEW"/>
                <Label fx:id="totalAccountsLabel" text="TOTAL ACCOUNTS: 0"/>
                <Label fx:id="totalBalanceLabel" text="TOTAL BALANCE: P0.00"/>
                <Label fx:id="message"/>
            </VBox>

            <VBox fx:id="accountPane" spacing="12"
                  visible="false" managed="false">
                <Label text="MY ACCOUNTS"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <ListView fx:id="accountList" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox fx:id="openAccountPane" spacing="10"
                  visible="false" managed="false">
                <Label text="OPEN NEW ACCOUNT"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="accountType" promptText="Account type" maxWidth="350"/>
                <TextField fx:id="openingBalance" promptText="Opening balance" maxWidth="350"/>
                <TextField fx:id="branch" promptText="Branch" maxWidth="350"/>
                <TextField fx:id="employerName" promptText="Employer name (cheque)" maxWidth="350"/>
                <TextField fx:id="employerAddress" promptText="Employer address (cheque)" maxWidth="350"/>
                <Button text="OPEN ACCOUNT" onAction="#openAccount"/>
                <Label fx:id="openAccountMessage"/>
            </VBox>

            <VBox fx:id="transactionsPane" spacing="12"
                  visible="false" managed="false">
                <Label text="DEPOSIT OR WITHDRAW"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="transactionAccount" promptText="Choose account" maxWidth="350"/>
                <ComboBox fx:id="transactionType" promptText="Transaction type" maxWidth="350"/>
                <TextField fx:id="transactionAmount" promptText="Amount" maxWidth="350"/>
                <Button text="SUBMIT TRANSACTION" onAction="#submitTransaction"/>
                <Label fx:id="transactionMessage"/>
            </VBox>

            <VBox fx:id="historyPane" spacing="12"
                  visible="false" managed="false">
                <Label text="TRANSACTION HISTORY"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="historyAccount" promptText="Choose account" maxWidth="350"/>
                <Button text="LOAD HISTORY" onAction="#loadHistory"/>
                <TextArea fx:id="historyText" editable="false"
                          wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>