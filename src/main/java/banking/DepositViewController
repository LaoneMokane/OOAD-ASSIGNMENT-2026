package banking;

import javafx.fxml.FXML;
import javafx.scene.control.ComboBox;
import javafx.scene.control.Label;
import javafx.scene.control.TextField;

public class DepositViewController {
    @FXML private Label accountNumber;
    @FXML private ComboBox<String> actionType;
    @FXML private TextField amount;
    @FXML private Label message;

    @FXML
    public void initialize() {
        Account account = AppContext.getSelectedAccount();
        accountNumber.setText(account.getAccountNO());

        actionType.getItems().addAll("DEPOSIT", "WITHDRAWAL");
        actionType.setValue("DEPOSIT");
    }

    @FXML
    private void submit() {
        try {
            Customer customer = AppContext.getCustomer();
            Account account = AppContext.getSelectedAccount();
            double value = Double.parseDouble(amount.getText());

            if ("DEPOSIT".equals(actionType.getValue())) {
                AppContext.getAccountController().deposit(
                    customer, account.getAccountNO(), value
                );
            } else {
                AppContext.getAccountController().withdraw(
                    customer, account.getAccountNO(), value
                );
            }

            message.setText("Transaction completed.");
        } catch (Exception e) {
            message.setText(e.getMessage());
        }
    }

    @FXML
    private void back() {
        SceneManager.show("dashboard-view.fxml", "Banking Dashboard");
    }
}